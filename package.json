{
  "name": "open-susty-scans",
  "version": "0.1.0",
  "description": "Issue-driven sustainability scanning with Lighthouse, CO2.js, and WSG mapping.",
  "type": "module",
  "main": "src/cli.js",
  "scripts": {
    "scan": "node src/cli.js",
    "scan:issue": "node src/cli.js --issue-file ./.tmp/issue.md --title \"SCAN: Example\"",
    "pages:build": "node src/report/build-pages-site.js",
    "issue:comment": "node src/report/post-issue-comment.js",
    "if:cli": "node src/impact-framework/cli.js",
    "impact:build": "node src/report/build-impact-framework-site.js"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@tgwf/co2": "^0.16.8",
    "chrome-launcher": "^1.1.1",
    "js-yaml": "^4.3.0",
    "lighthouse": "^13.4.1",
    "puppeteer": "^24.7.1"
  }
}
